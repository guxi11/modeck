{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modup:modes:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modes",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "defaults": {
      "$ref": "#/$defs/ids"
    },
    "modes": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mode"
      }
    },
    "resources": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "const": "local"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "url",
            "ref",
            "path"
          ],
          "properties": {
            "type": {
              "const": "git"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          }
        }
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rule",
            "skill"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "const": "exists"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "pattern"
          ],
          "properties": {
            "type": {
              "const": "glob"
            },
            "pattern": {
              "$ref": "#/$defs/path"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "dependency"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 214
            }
          }
        }
      ]
    },
    "skillBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "preload": {
          "type": "boolean"
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": {
          "$ref": "#/$defs/ids"
        },
        "priority": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        },
        "detect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        "rules": {
          "$ref": "#/$defs/ids"
        },
        "skills": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/skillBinding"
          }
        }
      }
    }
  }
}
