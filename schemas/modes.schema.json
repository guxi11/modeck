{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modeck:modes:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modes"
  ],
  "properties": {
    "defaults": {
      "$ref": "#/$defs/ids"
    },
    "modes": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mode"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "object",
          "maxProperties": 512,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/resourceString"
              },
              {
                "$ref": "#/$defs/source"
              }
            ]
          }
        },
        "skills": {
          "type": "object",
          "maxProperties": 512,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/resourceString"
              },
              {
                "$ref": "#/$defs/source"
              }
            ]
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "servers"
      ],
      "properties": {
        "servers": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mcpServer"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "const": "local"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": {
          "$ref": "#/$defs/ids"
        },
        "rules": {
          "$ref": "#/$defs/ids"
        },
        "skills": {
          "$ref": "#/$defs/ids"
        },
        "mcp": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "resourceString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3079,
      "description": "Relative local path or (use URL)/path to an installed Git resource"
    },
    "envRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "env"
      ],
      "properties": {
        "env": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "envRefs": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/envRef"
      }
    },
    "headerRefs": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/envRef"
      }
    },
    "mcpServer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transport",
            "command"
          ],
          "properties": {
            "transport": {
              "const": "stdio"
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "args": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^[^\\x00-\\x1f\\x7f]*$"
              }
            },
            "env": {
              "$ref": "#/$defs/envRefs"
            },
            "override": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transport",
            "url"
          ],
          "properties": {
            "transport": {
              "enum": [
                "http",
                "sse"
              ]
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3079
            },
            "headers": {
              "$ref": "#/$defs/headerRefs"
            },
            "override": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
