{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modeck:modes:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resources",
    "modes"
  ],
  "properties": {
    "defaults": {
      "$ref": "#/$defs/ids"
    },
    "modes": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mode"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "object",
          "maxProperties": 512,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/resourceString"
              },
              {
                "$ref": "#/$defs/source"
              }
            ]
          }
        },
        "skills": {
          "type": "object",
          "maxProperties": 512,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/resourceString"
              },
              {
                "$ref": "#/$defs/source"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "const": "local"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "url",
            "ref",
            "path"
          ],
          "properties": {
            "type": {
              "const": "git"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          }
        }
      ]
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": {
          "$ref": "#/$defs/ids"
        },
        "rules": {
          "$ref": "#/$defs/ids"
        },
        "skills": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "resourceString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3079,
      "description": "Relative local path or (use URL)/path to an installed Git resource"
    }
  }
}
