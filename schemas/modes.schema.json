{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modeck:modes:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resources",
    "modes"
  ],
  "properties": {
    "defaults": {
      "$ref": "#/$defs/ids"
    },
    "modes": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mode"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "object",
          "maxProperties": 512,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/resourceString"
              },
              {
                "$ref": "#/$defs/source"
              }
            ]
          }
        },
        "skills": {
          "type": "object",
          "maxProperties": 512,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/resourceString"
              },
              {
                "$ref": "#/$defs/source"
              }
            ]
          }
        }
      }
    },
    "plugins": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "const": "local"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "commit"],
          "properties": {
            "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "path": { "$ref": "#/$defs/path" }
          }
        },
        "agents": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": { "enum": ["claude", "codex"] }
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": {
          "$ref": "#/$defs/ids"
        },
        "rules": {
          "$ref": "#/$defs/ids"
        },
        "skills": {
          "$ref": "#/$defs/ids"
        },
        "plugins": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "resourceString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3079,
      "description": "Relative local path or (use URL)/path to an installed Git resource"
    }
  }
}
