{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-modes:selector:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "auto": {
      "type": "boolean"
    },
    "add": {
      "$ref": "#/$defs/ids"
    },
    "disable": {
      "$ref": "#/$defs/ids"
    }
  },
  "$defs": {
    "ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    }
  }
}
