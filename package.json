{
  "name": "modeck",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "bin": {
    "modeck": "dist/bin/modeck.mjs"
  },
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "import": "./dist/resources/index.js"
    },
    "./integration": {
      "types": "./dist/integration/index.d.ts",
      "import": "./dist/integration/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "assets"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && esbuild src/cli/bin.ts --bundle --platform=node --format=esm --target=node22 --alias:jsonc-parser=jsonc-parser/lib/esm/main.js --outfile=dist/bin/modeck.mjs --banner:js=\"import { createRequire as __modeckCreateRequire } from 'node:module'; const require = __modeckCreateRequire(import.meta.url);\""
  },
  "dependencies": {
    "@inquirer/checkbox": "3.0.1",
    "@inquirer/confirm": "5.1.20",
    "@inquirer/input": "4.2.1",
    "@inquirer/select": "4.3.4",
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1",
    "rulesync": "36.0.2",
    "smol-toml": "1.9.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
