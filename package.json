{
  "name": "modup",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "modup": "dist/bin/modup.mjs"
  },
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "import": "./dist/resources/index.js"
    },
    "./integration": {
      "types": "./dist/integration/index.d.ts",
      "import": "./dist/integration/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "skills"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && esbuild src/cli/bin.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/bin/modup.mjs --banner:js=\"import { createRequire as __modupCreateRequire } from 'node:module'; const require = __modupCreateRequire(import.meta.url);\""
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
